{
  "name": "elm-wa-amal-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "test:phase2:db": "node --test --test-concurrency=1 tests/phase2-db.mjs",
    "test:phase2:api": "tsx --test --test-concurrency=1 tests/phase2-api.test.ts",
    "test:phase2": "npm run test:phase2:db && npm run test:phase2:api",
    "phase2:reset": "node scripts/phase2-reset.mjs",
    "test:phase2:native": "node --test --test-concurrency=1 tests/phase2-provider-auth.test.mjs tests/phase2-provider-data.test.mjs",
    "phase2:native:init": "node scripts/provider-init.mjs",
    "test:phase2:retirement": "node --test tests/phase2-retirement.test.mjs",
    "phase2:native:plan": "node scripts/provider-init.mjs --plan",
    "phase2:native:apply": "node scripts/provider-init.mjs --apply",
    "test:phase2:hardening": "node --test --test-concurrency=1 tests/phase2-provider-plan.test.mjs tests/phase2-provider-fixture-safety.test.mjs tests/phase2-provider-launchers.test.mjs tests/phase2-provider-storage-preflight.test.mjs tests/phase2-retirement.test.mjs && tsx --test --test-concurrency=1 tests/phase2-provider-offline.test.ts",
    "test:phase2:init-postgres": "node --test --test-concurrency=1 tests/phase2-provider-init-postgres.test.mjs",
    "test:manual-payment": "node --test --test-concurrency=1 tests/manual-payment-db.test.mjs && tsx --test --test-concurrency=1 tests/manual-payment-api.test.ts",
    "test:manual-payment:http": "node --test --test-concurrency=1 tests/manual-payment-http.test.mjs",
    "demo:manual-payment": "node scripts/manual-payment-demo.mjs",
    "test:manual-payment:demo": "node --test --test-concurrency=1 tests/manual-payment-demo.test.mjs",
    "dev:academy": "ACADEMY_DEMO=synthetic-only next dev --hostname 127.0.0.1",
    "start:academy": "ACADEMY_DEMO=synthetic-only next start --hostname 127.0.0.1",
    "test:academy": "tsx --test --test-concurrency=1 tests/academy-model.test.ts tests/academy-browser-preview.test.ts tests/academy-hardening.test.ts",
    "test:preview": "playwright test --config=playwright.preview.config.ts",
    "test:family": "tsx --test --test-concurrency=1 tests/family-registration.test.ts tests/family-registration-route.test.ts tests/family-callback.test.ts && node --test --test-concurrency=1 tests/family-registration-db.test.mjs",
    "test:family:browser": "playwright test --config=playwright.family.config.ts",
    "test:learner": "tsx --test --test-concurrency=1 tests/learner-workspace.test.ts",
    "test:learner:browser": "playwright test --config=playwright.learner.config.ts",
    "test:learner:persistence": "tsx --test --test-concurrency=1 tests/learner-persistence.test.ts && node --test --test-concurrency=1 tests/learner-persistence-db.test.mjs",
    "check:family:connection": "tsx scripts/family-review.ts --check",
    "dev:family": "tsx scripts/family-review.ts --serve",
    "test:teacher": "tsx --test tests/teacher-demo-access.test.ts tests/teacher-demo-model.test.ts",
    "test:teacher:browser": "playwright test --config=playwright.teacher.config.ts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
