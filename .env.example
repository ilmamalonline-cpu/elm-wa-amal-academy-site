# Synthetic local Phase 2 harness ONLY. Default is disabled.
# The test harness injects an ephemeral public verification key and private fixture directory.
# Never put production Supabase credentials or real user/child data here.
PHASE2_LOCAL_SECURITY=disabled
PHASE2_DATABASE_URL=
PHASE2_JWT_PUBLIC_KEY=
PHASE2_PRIVATE_ROOT=
# Disposable test runner only (not the app):
# PHASE2_TEST_DATABASE_URL=postgresql://ubuntu@127.0.0.1:55432/phase2_test
# PHASE2_ALLOW_RESET=synthetic-only

# Canonical native-provider tests use scripts/provider/ launchers and restricted
# ephemeral runtime files outside this project, not credentials in this file.
# See scripts/provider/README-native.md for explicit synthetic-only prerequisites.
# The incompatible alternative adapter/installer and its settings are retired.

# Local manual-payment prototype ONLY; unset means disabled.
# Never apply db/manual-payment.sql to a prepared or live database.
# PHASE2_MANUAL_PAYMENT=synthetic-only
# Tests create and remove their OWN fresh loopback PostgreSQL16 cluster:
# MANUAL_PAYMENT_TEST=synthetic-only npm run test:manual-payment

# Local educational workspace; disabled when unset. No hosted service is used.
# Prefer npm run dev:academy (loopback only); never enter real personal data.
# ACADEMY_DEMO=synthetic-only

# Browser-only synthetic preview is selected server-side on VERCEL_ENV=preview.
# Do NOT add auth/payment/Zoom/Supabase secrets for a synthetic preview.
# Local verification only (never enables Vercel production):
# ACADEMY_PREVIEW=browser-synthetic-only

# Family registration preparation: separate from every synthetic/demo adapter.
# Disabled by default; loopback-only even with this opt-in. Blocked on Vercel.
# Hosted setup/read-only preparation is approved; real accounts/email/public launch are NOT.
# Use npm run check:family:connection or dev:family with the saved key injected
# into the process environment only. Never save its real value in this file or .env.
# ACADEMY_FAMILY_REGISTRATION=local-review
# ACADEMY_SUPABASE_URL=https://vbulxdnfknoybdkuhayz.supabase.co
# Publishable (or legacy anon) key ONLY. Never service_role, DB password or Zoom secret.
# ACADEMY_SUPABASE_PUBLISHABLE_KEY=
# No public-launch flag exists. Public enablement requires a separately approved change.
